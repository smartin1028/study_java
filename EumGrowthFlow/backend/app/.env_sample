# LLM provider configuration
# 사용할 Provider 선택: "ollama" (로컬), "deepseek" (클라우드), "openai" (클라우드)
LLM_PROVIDER=ollama

# ---- Ollama 설정 (LLM_PROVIDER=ollama) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:1.5b

# ---- DeepSeek API 설정 (LLM_PROVIDER=deepseek) ----
# https://platform.deepseek.com 에서 API Key 발급
DEEPSEEK_API_KEY=your_deepseek_api_key
# 모델: deepseek-v4-flash (빠름), deepseek-v4-pro (고품질)
DEEPSEEK_MODEL=deepseek-v4-flash

# Bearer token for LLM API authentication
LLM_BEARER_TOKEN=your_token_here

# ---- OpenAI API 설정 (LLM_PROVIDER=openai) ----
# https://platform.openai.com 에서 API Key 발급
OPENAI_API_KEY=your_openai_api_key
# 모델: gpt-4.1 (고품질), gpt-4.1-mini (빠름/추천), gpt-4.1-nano (가장 빠름)
OPENAI_MODEL=gpt-4.1-mini

# ---- 로그 설정 ----
# 로테이션 방식: "size" (파일 크기) 또는 "time" (시간)
LOG_ROTATION=size
# size 모드: 로그 파일 최대 크기 (MB)
LOG_MAX_MB=10
# 보관할 백업 파일 개수
LOG_BACKUP_COUNT=5
# time 모드: 로테이션 주기 (S=초, M=분, H=시간, D=일, midnight=자정, W0~W6=요일)
LOG_ROTATION_WHEN=midnight
# time 모드: 로테이션 간격 (예: when=H, interval=6 → 6시간마다)
LOG_ROTATION_INTERVAL=1
